# ==============================================================================
# PTE ACADEMIC SIMULATOR - ENVIRONMENT CONFIGURATION
# Copy this file to .env or configure these variables in Vercel Project Settings
# ==============================================================================

# Server Port (Defaults to 3001 locally, automatically managed by Vercel in production)
PORT=3001

# AI Automated Grading API Keys (Optional - Can also be configured directly in Teacher Portal UI)
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Sheets Manual Scoring Sync Webhook (Google Apps Script /exec URL)
GOOGLE_SHEET_WEBHOOK_URL=

# Storage Paths (Optional - Defaults to local repo directory or /tmp in serverless)
# USER_DATA_PATH=
# QUESTION_BANK_DIR=


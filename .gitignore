# Dependencies
node_modules/

# Production builds
dist/
dist-ssr/
*.local

# Environment variables & secrets
.env
.env.*
!.env.example

# Ephemeral runtime recordings, TTS audio cache, and export zips
submissions/recordings/*
!submissions/recordings/.gitkeep
submissions/tts_cache/*
!submissions/tts_cache/.gitkeep
submissions/exports/*
!submissions/exports/.gitkeep
server/storage/recordings/*

# Audio binary recording dumps
*.webm
*.wav

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sw?
.vercel
